# Copiez ce fichier en .env et exportez les variables dans votre environnement.
PRICE_MONITOR_HOST=127.0.0.1
PRICE_MONITOR_PORT=8080
PRICE_MONITOR_ENV=development
PRICE_MONITOR_LOG_LEVEL=INFO
PRICE_MONITOR_SERVICE_NAME=price-monitor
# Required for /api/collect and /api/observations. Keep it out of source control.
PRICE_MONITOR_API_KEY=
# Enabled automatically when PRICE_MONITOR_ENV=production.
PRICE_MONITOR_RATE_LIMIT_REQUESTS=60
PRICE_MONITOR_RATE_LIMIT_WINDOW_SECONDS=60
# PRICE_MONITOR_RATE_LIMIT_ENABLED=true
PRICE_MONITOR_DEMO=false
PRICE_MONITOR_DB_BACKEND=sqlite
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Optional price alerts. Values are JSON; use product keys gasoil, brent and bitume.
# Example: {"brent":{"above":90,"below":70},"gasoil":{"above":3.5},"bitume":{"above":600}}
PRICE_MONITOR_ALERT_THRESHOLDS=
# Teams incoming webhooks and most generic webhook endpoints accept this payload.
PRICE_MONITOR_ALERT_WEBHOOK_URL=
PRICE_MONITOR_ALERT_WEBHOOK_TIMEOUT_SECONDS=10
# Optional SMTP delivery. Multiple recipients are comma-separated.
PRICE_MONITOR_ALERT_EMAIL_TO=
PRICE_MONITOR_ALERT_SMTP_HOST=
PRICE_MONITOR_ALERT_SMTP_PORT=587
PRICE_MONITOR_ALERT_SMTP_USER=
PRICE_MONITOR_ALERT_SMTP_PASSWORD=
PRICE_MONITOR_ALERT_SMTP_FROM=
PRICE_MONITOR_ALERT_SMTP_USE_TLS=true
PRICE_MONITOR_ALERT_NOTIFY_RECOVERY=true
# PRICE_MONITOR_DATA=C:\\chemin\\vers\\market_prices.csv
# PRICE_MONITOR_DB=C:\\chemin\\vers\\price_monitor.db
# PRICE_MONITOR_BACKUP_DIR=C:\\chemin\\vers\\backups

# MySQL (set PRICE_MONITOR_DB_BACKEND=mysql to enable)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=price_monitor
MYSQL_USER=price_monitor
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
